# smart-search-mcp 环境变量模板（仅键名与占位说明，真实 Key 绝不入库）
#
# 注意：本服务不自动加载 .env 文件。请通过以下任一方式注入：
#   1) MCP 客户端配置的 "env" 字段（推荐，见 README）
#   2) 启动 MCP Server 的 shell 环境变量
#   3) 直接编辑 keys.json（已被 .gitignore 忽略）
#
# 加载优先级：环境变量 > keys.json。未配置的引擎自动从并发池剔除，
# 全部未配置时 smart_search 等价于免费链路（DDG -> Bing，仍可用）。
#
# 获取入口：Exa dashboard.exa.ai · Tavily app.tavily.com
#           · Brave api.search.brave.com · Firecrawl firecrawl.dev/app/api-keys

EXA_API_KEY=your-exa-key-here
TAVILY_API_KEY=your-tavily-key-here
BRAVE_API_KEY=your-brave-key-here
FIRECRAWL_API_KEY=your-firecrawl-key-here
